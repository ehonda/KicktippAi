<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- TODO: Migrate to Directory.Build.props -->
        <RootNamespace>EHonda.KicktippAi.$(MSBuildProjectName)</RootNamespace>
        <AssemblyName>EHonda.KicktippAi.$(MSBuildProjectName)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CsvHelper" />
      <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" />
      <PackageReference Include="NodaTime" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="..\..\data\bundesliga-2026-27\club-elo-launch-seed.csv">
        <LogicalName>EHonda.KicktippAi.Core.Data.Bundesliga2026_27ClubEloLaunchSeed.csv</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="..\..\data\bundesliga-2026-27\rosters\roster-membership-seed.csv">
        <LogicalName>EHonda.KicktippAi.Core.Data.Bundesliga2026_27RosterMembershipSeed.csv</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="..\..\data\bundesliga-2026-27\team-manifest.csv">
        <LogicalName>EHonda.KicktippAi.Core.Data.Bundesliga2026_27TeamManifest.csv</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="..\..\data\bundesliga-2026-27\history\history-played-dates.csv">
        <LogicalName>EHonda.KicktippAi.Core.Data.Bundesliga2026_27HistoryPlayedDates.csv</LogicalName>
      </EmbeddedResource>
    </ItemGroup>

</Project>
