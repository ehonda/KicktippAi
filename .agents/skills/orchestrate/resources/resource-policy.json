{
  "schemaVersion": 4,
  "worktree": {
    "activeBuildCapableGrowthReservationGiB": 1.25,
    "uncertainGrowthReservationGiB": 1.25,
    "minimumEffectiveFreeGiBAfterReservation": 14.0,
    "minimumFreeDiskPercentWarning": 15.0
  },
  "heavyOperation": {
    "preferredAvailableMemoryFloorGiB": 1.0,
    "absoluteAvailableMemoryFloorGiB": 0.5,
    "warningAvailableMemoryGiB": 1.5,
    "provisionalProjectGateReservationGiB": 0.85,
    "maximumLogicalProcessorFraction": 1.0,
    "unmeasuredOperationsAreExclusive": true,
    "operationProfile": {
      "requiredRequestFields": [
        "profile",
        "fingerprint",
        "memoryReservationGiB",
        "recoverable",
        "effectClass",
        "maximumWorkerFanout",
        "fanoutControllable"
      ],
      "allowedEffectClasses": [
        "local-only",
        "external-or-live"
      ],
      "requiredOutcomeEvidence": [
        "profile",
        "fingerprint",
        "startedAvailableMemoryGiB",
        "minimumAvailableMemoryGiB",
        "finishedAvailableMemoryGiB",
        "commitHealth",
        "pagingHealth",
        "durationSeconds",
        "outcome",
        "memorySymptoms",
        "causalQueueDelaySeconds"
      ],
      "durableReservationReductionRequiresOwnerReviewedRepositoryChange": true
    },
    "degraded": {
      "availableMemoryFloorGiB": 1.0,
      "maximumConcurrentProfiles": 1,
      "maximumWorkerFanout": 1,
      "recoverableRetryLimit": 1
    }
  }
}
